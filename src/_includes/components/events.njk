{% macro calendarIcon(classes) %}
<svg class="{{ classes }} shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
</svg>
{% endmacro %}

{% macro pinIcon(classes) %}
<svg class="{{ classes }} shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
</svg>
{% endmacro %}

{% macro heroCard(event, isPast) %}
<a href="{{ event.url }}" target="_blank" rel="noopener noreferrer"
   class="group flex flex-col h-full rounded-2xl overflow-hidden bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
  {% if event.image %}
  <div class="aspect-video overflow-hidden">
    <img src="{{ event.image }}" alt="{{ event.title }}"
         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
  </div>
  {% endif %}
  <div class="flex flex-col flex-1 p-6">
    <span class="inline-block w-fit bg-rf-grey text-rf-blue text-xs font-bold px-3 py-1 rounded-full mb-4">
      {% if isPast %}Most Recent Event{% else %}Featured Event{% endif %}
    </span>
    <h3 class="text-2xl font-bold text-rf-blue mb-2">{{ event.title }}</h3>
    <p class="text-gray-600 text-sm mb-4 line-clamp-3">{{ event.description }}</p>
    <div class="flex flex-col gap-1 text-sm text-gray-600 mb-5">
      <div class="flex items-center gap-2">
        {{ calendarIcon("w-4 h-4") }}
        <span>{{ event.date }} &middot; {{ event.time }}</span>
      </div>
      <div class="flex items-center gap-2">
        {{ pinIcon("w-4 h-4") }}
        <span>{{ event.venue if event.venue else event.address }}</span>
      </div>
    </div>
    <span class="inline-block w-fit mt-auto bg-green-500 group-hover:bg-green-600 text-white text-sm font-semibold px-5 py-2 rounded-lg transition-colors">
      Learn More
    </span>
  </div>
</a>
{% endmacro %}

{% macro listCard(event) %}
<a href="{{ event.url }}" target="_blank" rel="noopener noreferrer"
   class="block rounded-xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-5">
  <h3 class="text-lg font-bold text-rf-blue mb-1">{{ event.title }}</h3>
  <p class="text-gray-600 text-sm mb-3 line-clamp-2">{{ event.description }}</p>
  <div class="flex flex-col gap-1 text-sm text-gray-600">
    <div class="flex items-center gap-2">
      {{ calendarIcon("w-4 h-4") }}
      <span>{{ event.date }} &middot; {{ event.time }}</span>
    </div>
    <div class="flex items-center gap-2">
      {{ pinIcon("w-4 h-4") }}
      <span>{{ event.venue if event.venue else event.address }}</span>
    </div>
  </div>
</a>
{% endmacro %}

{% if events.items.length > 0 %}
<section class="py-16 lg:py-24">
  <div class="max-w-screen-xl mx-auto px-5">
    <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight  text-rf-blue mb-10">
      {% if events.isPast %}Featured Events{% else %}Upcoming Events{% endif %}
    </h2>

    {% set eventList = events.items | head(3) %}

    {# --- Desktop: hero card + stacked list (hidden on mobile) --- #}
    <div class="hidden md:grid md:grid-cols-5 gap-6 items-stretch">
      <div class="md:col-span-3">
        {{ heroCard(eventList[0], events.isPast) }}
      </div>
      <div class="md:col-span-2 flex flex-col gap-6">
        {% for event in eventList %}
          {% if not loop.first %}{{ listCard(event) }}{% endif %}
        {% endfor %}
      </div>
    </div>

    {# --- Mobile: single-column stack (hidden on desktop) --- #}
    <div class="flex flex-col gap-6 md:hidden">
      {% for event in eventList %}
        {% if loop.first %}{{ heroCard(event, events.isPast) }}{% else %}{{ listCard(event) }}{% endif %}
      {% endfor %}
    </div>

    <p class="text-center text-sm text-rf-blue/80 mt-12 max-w-2xl mx-auto">
      Refresh DC is a collegial, educational community organized and attended by professionals from diverse backgrounds. We kindly ask that all attendees, speakers, hosts, and sponsors abide by our <a href="/conduct" class="underline hover:text-rf-blue">Code of Conduct</a>.
    </p>

  </div>
</section>
{% endif %}
